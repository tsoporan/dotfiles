#!/usr/bin/env bash
# Claude Code status line (wired up as statusLine.command in
# ~/.claude/settings.json). Reads the session JSON on stdin and prints:
#
#   Opus 5.5 high · 312k/700k · 5h 41% · 7d 18% · landmark-spine
#
# The context figure is the input tokens of the last request against
# CLAUDE_STATUSLINE_HANDOFF_AT (700000, keep it equal to autoCompactWindow).
# It turns yellow at 60% of that and red with "handoff" at 80%, so there is
# time to hand off before Claude Code compacts.
#
# Two side outputs, both for herdr:
#   - inside a herdr pane, the context size goes on the agent's sidebar row as
#     the $ctx token, and $handoff is set once it is time to hand off;
#   - the usage figures go to $XDG_RUNTIME_DIR/claude-statusline/usage.<account>
#     (one file per account, so claude and claude-work don't overwrite each
#     other), and all of them, labelled, to .../usage, which herdr's tab bar shows.

set -uo pipefail

handoff_at=${CLAUDE_STATUSLINE_HANDOFF_AT:-700000}

# One line of tab-separated fields; a missing value is "-".
fields=$(jq -r '
  [
    (.model.display_name // "Claude"),
    (.effort.level // "-"),
    ((.context_window.used_percentage // 0) * (.context_window.context_window_size // 0) / 100 | round),
    (.rate_limits.five_hour.used_percentage // "-" | if type == "number" then round else . end),
    (.rate_limits.seven_day.used_percentage // "-" | if type == "number" then round else . end),
    ((.workspace.current_dir // .cwd // "") | split("/") | last // "" | if . == "" then "-" else . end)
  ] | map(tostring) | join("\t")
' 2>/dev/null) || fields=""
if [[ -z $fields ]]; then
  printf 'Claude Code'
  exit 0
fi
IFS=$'\t' read -r model effort tokens five_hour seven_day dir <<<"$fields"
[[ $tokens =~ ^[0-9]+$ ]] || tokens=0
[[ $five_hour =~ ^[0-9]+$ ]] || five_hour="-"
[[ $seven_day =~ ^[0-9]+$ ]] || seven_day="-"

paint() { printf '\033[%sm%s\033[0m' "$1" "$2"; }
# level <value> <warn> <crit>: grey, yellow or red.
level() { if (($1 >= $3)); then echo 31; elif (($1 >= $2)); then echo 33; else echo 90; fi; }
thousands() { if (($1 >= 1000)); then echo "$((($1 + 500) / 1000))k"; else echo "$1"; fi; }

ctx="$(thousands "$tokens")"
ctx_pct=$((tokens * 100 / handoff_at))
handoff=""
((ctx_pct >= 80)) && handoff="handoff"

parts=("$(paint 2 "$model")")
[[ $effort != - ]] && parts[0]+=" $(paint 36 "$effort")"
parts+=("$(paint "$(level "$ctx_pct" 60 80)" "$ctx/$(thousands "$handoff_at")${handoff:+ $handoff}")")
usage=""
if [[ $five_hour != - ]]; then
  parts+=("$(paint "$(level "$five_hour" 70 90)" "5h $five_hour%")")
  usage="5h $five_hour%"
fi
if [[ $seven_day != - ]]; then
  parts+=("$(paint "$(level "$seven_day" 70 90)" "7d $seven_day%")")
  usage+="${usage:+ · }7d $seven_day%"
fi
[[ $dir != - ]] && parts+=("$(paint 33 "$dir")")

sep=" $(paint 90 "·") "
line=""
for part in "${parts[@]}"; do line+="${line:+$sep}$part"; done
printf '%s' "$line"

# Side outputs run detached so a slow herdr never delays the status line.
{
  if [[ -n $usage ]]; then
    usage_dir=${XDG_RUNTIME_DIR:-/tmp}/claude-statusline
    mkdir -p "$usage_dir"
    # Usage is per account, and claude-work runs with CLAUDE_CONFIG_DIR=~/.claude-work:
    # name the account after its config folder ("me" for ~/.claude, "work" for ~/.claude-work).
    account=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
    account=${account%/}
    account=${account##*/.claude}
    account=${account#-}
    account=${account:-me}
    (
      flock 9
      shopt -s nullglob
      printf '%s' "$usage" >"$usage_dir/.tmp.$$" && mv "$usage_dir/.tmp.$$" "$usage_dir/usage.$account"
      # Drop accounts untouched for 2 hours so stale figures leave the tab bar.
      find "$usage_dir" -maxdepth 1 -name 'usage.*' -mmin +120 -delete
      # Rebuild the line herdr shows from every active account's file, labelled
      # once there is more than one.
      files=("$usage_dir"/usage.*)
      combined=""
      for f in "${files[@]}"; do
        ((${#files[@]} > 1)) && label="${f##*/usage.} " || label=""
        combined+="${combined:+   }$label$(<"$f")"
      done
      printf '%s' "$combined" >"$usage_dir/.tmp.$$" && mv "$usage_dir/.tmp.$$" "$usage_dir/usage"
    ) 9>"$usage_dir/.lock"
  fi
  if [[ ${HERDR_ENV:-} == 1 && -n ${HERDR_PANE_ID:-} ]]; then
    report=(herdr pane report-metadata "$HERDR_PANE_ID" --source claude-statusline --token "ctx=$ctx")
    if [[ -n $handoff ]]; then report+=(--token "handoff=$handoff"); else report+=(--clear-token handoff); fi
    timeout 2 "${report[@]}"
  fi
} >/dev/null 2>&1 &
