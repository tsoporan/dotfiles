# ==============================================================================
# Ghostty Terminal Configuration
# Last updated: 2026-09-11
# ==============================================================================
#
# Docs: https://ghostty.org/docs/config
# Run `ghostty +show-config --default --docs` for all options
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Font
# ------------------------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 14
adjust-cell-height = 2
bold-is-bright = false

# ------------------------------------------------------------------------------
# Theme (same black + electric yellow as Hyprland / waybar)
# ------------------------------------------------------------------------------
background = #0a0a0a
foreground = #e0e0e0
selection-background = #2a2a2a
selection-foreground = #e6fb04

palette = 0=#0a0a0a
palette = 1=#c01c28
palette = 2=#26a269
palette = 3=#e6fb04
palette = 4=#3584e4
palette = 5=#813d9c
palette = 6=#1a9b8a
palette = 7=#e0e0e0
palette = 8=#606060
palette = 9=#e01b24
palette = 10=#33d17a
palette = 11=#f5ff5a
palette = 12=#62a0ea
palette = 13=#c061cb
palette = 14=#5bc8af
palette = 15=#ffffff

# ------------------------------------------------------------------------------
# Cursor
# ------------------------------------------------------------------------------
cursor-style = block
cursor-style-blink = false
cursor-color = #e6fb04

# ------------------------------------------------------------------------------
# Window
# ------------------------------------------------------------------------------
window-padding-x = 4
window-padding-y = 4
window-decoration = false
window-inherit-working-directory = true
confirm-close-surface = false
background-opacity = 1
unfocused-split-opacity = 1
# Do not use Adwaita window chrome; that grey is lighter than the bar.
window-theme = ghostty

# ------------------------------------------------------------------------------
# Behavior
# ------------------------------------------------------------------------------
# PRIMARY only. clipboard would overwrite Ctrl+V on every highlight.
copy-on-select = true
mouse-hide-while-typing = true
scrollback-limit = 50000

# Hyprland: avoid the GTK renderer stall
# https://github.com/ghostty-org/ghostty/discussions/3224
async-backend = epoll

# ------------------------------------------------------------------------------
# Keybindings
# ------------------------------------------------------------------------------
# Super+C/V inject these in terminals (see hypr/scripts/clipboard.sh)
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard

# Shift+Enter sends literal newline (useful in some TUI apps)
keybind = shift+enter=text:\n

# Quick font size adjustments
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+0=reset_font_size
